<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="settings.xml" />
        <include domain="file" path="current_game.json" />
        <include domain="file" path="worlds/" />
        <include domain="sharedpref" path="choices.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings.xml" />
        <include domain="file" path="current_game.json" />
        <include domain="file" path="worlds/" />
        <include domain="sharedpref" path="choices.xml" />
    </device-transfer>
</data-extraction-rules>
