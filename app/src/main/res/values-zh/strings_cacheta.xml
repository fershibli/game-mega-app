    <string name="game_cacheta">卡舍塔（Cacheta）</string>
    <string name="howto_cacheta">摸牌、弃牌，直到所有手牌都组成顺子和三条，然后抢在电脑之前按“Bater!”（胡牌）。</string>
    <string name="cacheta_variant_classic">经典</string>
    <string name="cacheta_variant_classic_desc">两副牌，每人9张，没有百搭牌。</string>
