    <string name="chess_famous_immortal">不朽之局</string>
    <string name="chess_famous_immortal_where">伦敦，1851年</string>
    <string name="chess_famous_immortal_about">安德森先后弃掉双车、一象，最后连后也弃掉，仍用剩下的三个轻子将死对方。这是那个时代最著名的进攻对局。</string>
    <string name="chess_famous_evergreen">常青之局</string>
    <string name="chess_famous_evergreen_where">柏林，1852年</string>
    <string name="chess_famous_evergreen_about">平静的局面突然爆发：安德森弃后，并用双象漂亮地将死对方。它的美永不褪色，因此被称为“常青”。</string>
    <string name="chess_famous_opera">歌剧院之局</string>
    <string name="chess_famous_opera_where">巴黎，1858年</string>
    <string name="chess_famous_opera_about">在巴黎歌剧院演出期间于包厢中下成。莫菲迅速出动子力，最后弃后将杀，是一堂完美的出子课。</string>
    <string name="chess_famous_steinitz">斯坦尼茨的杰作</string>
    <string name="chess_famous_steinitz_where">黑斯廷斯，1895年</string>
    <string name="chess_famous_steinitz_about">第一位世界冠军任由一车被吃，用另一车连续将军。巴德勒本不愿被将死，默默离开了赛场，斯坦尼茨随后向观众演示了杀法。</string>
    <string name="chess_famous_reti">雷蒂的速胜</string>
    <string name="chess_famous_reti_where">维也纳，1910年</string>
    <string name="chess_famous_reti_about">最短的名局之一：第9步弃后，接着双将，第11步用象将死。</string>
    <string name="chess_famous_century">世纪之局</string>
    <string name="chess_famous_century_where">纽约，1956年</string>
    <string name="chess_famous_century_about">十三岁的鲍比·费舍尔在第17步弃后，用一群轻子的猛攻取胜。一位棋评家称之为“世纪之局”。</string>
    <string name="chess_famous_kasparov">卡斯帕罗夫的不朽之局</string>
    <string name="chess_famous_kasparov_where">维克安泽，1999年</string>
    <string name="chess_famous_kasparov_about">卡斯帕罗夫弃车，并把托帕洛夫的王赶过整个棋盘。它常被称为史上最美的对局之一。</string>
