    <!-- Magic cube (color cube puzzle) -->
    <string name="game_cube">魔方</string>
    <string name="howto_cube">转动各层，直到每一面都只有一种颜色。在贴纸上滑动手指可转动它所在的一排；在空白处拖动可从别的角度看魔方；也可以在下方选一个面，再点圆形箭头。</string>
    <string name="cube_variant_2">2×2×2</string>
    <string name="cube_variant_2_desc">8 块的小魔方：最轻松的开始。</string>
    <string name="cube_variant_3">3×3×3</string>
    <string name="cube_variant_3_desc">经典魔方。提示会教你一层一层地还原。</string>
    <string name="cube_variant_4">4×4×4</string>
    <string name="cube_variant_4_desc">更大的魔方，中心不固定。用“层”按钮转动里面的层。</string>
    <string name="cube_variant_5">5×5×5</string>
    <string name="cube_variant_5_desc">最大的魔方，适合有耐心的人。</string>
