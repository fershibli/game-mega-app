<resources>
    <string name="game_nonogram">数织</string>
    <string name="howto_nonogram">按数字涂色：每行左边和每列上方的数字表示连续涂色的方格数量，按顺序排列，各组之间至少空一格。涂对方格，就会出现一幅图画。</string>
    <string name="nonogram_tap_cell">点一下方格涂色，长按标记✕，拖动可以涂一整行。</string>
    <string name="nonogram_cross_on">标记模式：点一下应该留空的方格（✕）。</string>
    <string name="nonogram_cross">标记</string>
    <string name="nonogram_it_is">图画是：%1$s</string>
