<resources>
    <string name="game_nonogram">Nonogramme</string>
    <string name="howto_nonogram">Peindre avec des nombres : les nombres à côté de chaque ligne et au-dessus de chaque colonne indiquent combien de cases à la suite sont peintes, dans l’ordre, avec un espace entre les groupes. Peignez les bonnes cases pour découvrir l’image.</string>
    <string name="nonogram_tap_cell">Touchez une case pour la peindre. Appuyez longuement pour mettre ✕. Glissez pour peindre une ligne.</string>
    <string name="nonogram_cross_on">Mode marquage : touchez les cases qui restent vides (✕).</string>
    <string name="nonogram_cross">Marquer</string>
    <string name="nonogram_it_is">L’image : %1$s</string>
