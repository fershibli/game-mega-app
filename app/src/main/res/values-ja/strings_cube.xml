    <!-- Magic cube (color cube puzzle) -->
    <string name="game_cube">キューブパズル</string>
    <string name="howto_cube">各面が一色になるまで層を回しましょう。シールの上を指でなぞるとその列が回ります。何もない所をドラッグすると向きを変えられます。下で面を選んで丸い矢印を押しても回せます。</string>
    <string name="cube_variant_2">2×2×2</string>
    <string name="cube_variant_2_desc">8個のピースの小さなキューブ。いちばんやさしい入門です。</string>
    <string name="cube_variant_3">3×3×3</string>
    <string name="cube_variant_3_desc">定番のキューブ。ヒントで一段ずつそろえる方法を学べます。</string>
    <string name="cube_variant_4">4×4×4</string>
    <string name="cube_variant_4_desc">大きめのキューブで、中心が固定されていません。内側の層は「層」ボタンで選びます。</string>
    <string name="cube_variant_5">5×5×5</string>
    <string name="cube_variant_5_desc">いちばん大きなキューブ。じっくり楽しみたい方に。</string>
