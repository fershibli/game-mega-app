<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="game_ludo">Лудо</string>
    <string name="howto_ludo">Бросайте кубик и проведите четыре фишки по кругу доски до центра. Чтобы вывести фишку, нужна шестёрка. Встаньте на фишку соперника, чтобы отправить её домой. Побеждает тот, кто первым приведёт все четыре фишки в центр.</string>
    <string name="ludo_variant_classic">Классика</string>
    <string name="ludo_variant_classic_desc">Клетки со звездой безопасны, шестёрка даёт ещё бросок, три шестёрки подряд — ход пропадает.</string>
    <string name="ludo_variant_simple">Простые</string>
    <string name="ludo_variant_simple_desc">Безопасных клеток нет: любую фишку можно сбить. Шестёрка всё так же даёт ещё бросок.</string>
    <string name="ludo_red">Красный</string>
